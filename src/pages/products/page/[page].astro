---
// src/pages/products/page/[page].astro
import type { GetStaticPaths, Page } from "astro"
import type { Product } from "@/types/product"
import ProductsPage from "@/components/products/products-page"
import Layout from "@/layouts/main.astro"
import { getAllProducts } from "@/utils/products"
import PaginationWithPrimaryButton from "@/components/pagination-02"

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  // 1. Load all json files using your fs helper function
  const allProducts = getAllProducts()

  // 2. Filter out drafts using plain JavaScript
  const publishedProducts = allProducts.filter(
    (item) => item.status === "published"
  )

  // 3. Hand it to Astro's paginate engine (12 items per page)
  return paginate(publishedProducts, { pageSize: 3 })
}

// Define the Props interface using Astro's generic Page type wrapped around your Product type
interface Props {
  page: Page<Product>
}

// Grab the page properties safely typed by TypeScript
const { page } = Astro.props

const productsOnThisPage = page.data
const paginationInfo = {
  currentPage: page.currentPage,
  lastPage: page.lastPage,
  hasNext: typeof page.url.next === "string",
  hasPrev: typeof page.url.prev === "string",
  nextUrl: page.url.next,
  prevUrl: page.url.prev,
}
---

<Layout>
  <ProductsPage passedProducts={productsOnThisPage} />
  <PaginationWithPrimaryButton
    baseUrl="/products/page"
    pagination={paginationInfo}
  />
</Layout>
