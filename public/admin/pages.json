{
    "$schema": "https://unpkg.com/@sveltia/cms@0.170.5/schema/sveltia-cms.json",
    "collections": [
        {
            "name": "Pages",
            "label": "Pages",
            "files": [
                {
                    "name": "testimonials",
                    "label": "Testimonials",
                    "file": "content/pages/testimonials.json",
                    "format": "json",
                    "fields": [
                        {
                            "label": "Enabled",
                            "name": "enabled",
                            "widget": "boolean",
                            "default": true
                        },
                        {
                            "label": "Title",
                            "name": "title",
                            "widget": "string"
                        },
                        {
                            "label": "Description",
                            "name": "description",
                            "widget": "text"
                        },
                        {
                            "label": "Testimonials List",
                            "name": "testimonials",
                            "widget": "list",
                            "fields": [
                                {
                                    "name": "id",
                                    "widget": "hidden",
                                    "default": "{{uuid_short}}"
                                },
                                {
                                    "label": "Name",
                                    "name": "name",
                                    "widget": "string"
                                },
                                {
                                    "label": "Role / Designation",
                                    "name": "role",
                                    "widget": "string"
                                },
                                {
                                    "label": "Message",
                                    "name": "message",
                                    "widget": "text"
                                },
                                {
                                    "label": "Rating",
                                    "name": "rating",
                                    "widget": "number",
                                    "value_type": "int",
                                    "min": 1,
                                    "max": 5,
                                    "default": 5
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "home",
                    "label": "Home Page",
                    "file": "content/pages/home.json",
                    "format": "json",
                    "fields": [
                        {
                            "name": "categoriesSection",
                            "label": "Categories Section",
                            "widget": "object",
                            "fields": [
                                {
                                    "name": "heading",
                                    "label": "Heading",
                                    "widget": "string"
                                },
                                {
                                    "name": "subHeading",
                                    "label": "Sub Heading",
                                    "widget": "string",
                                    "required": false
                                },
                                {
                                    "name": "maxItems",
                                    "label": "Max Categories",
                                    "widget": "number",
                                    "value_type": "int",
                                    "default": 6,
                                    "max": 100,
                                    "min": 3
                                },
                                {
                                    "name": "btnTxt",
                                    "label": "Button Text",
                                    "widget": "string"
                                },
                                {
                                    "name": "design",
                                    "label": "Section Design",
                                    "widget": "select",
                                    "options": [
                                        "default"
                                    ],
                                    "default": "default"
                                }
                            ]
                        },
                        {
                            "name": "productsSection",
                            "label": "Products Section",
                            "widget": "object",
                            "fields": [
                                {
                                    "name": "heading",
                                    "label": "Heading",
                                    "widget": "string"
                                },
                                {
                                    "name": "subHeading",
                                    "label": "Sub Heading",
                                    "widget": "string",
                                    "required": false
                                },
                                {
                                    "name": "maxItems",
                                    "label": "Max Categories",
                                    "widget": "number",
                                    "value_type": "int",
                                    "default": 6,
                                    "max": 100,
                                    "min": 0
                                },
                                {
                                    "name": "btnTxt",
                                    "label": "Button Text",
                                    "widget": "string"
                                },
                                {
                                    "name": "design",
                                    "label": "Section Design",
                                    "widget": "select",
                                    "options": [
                                        "default"
                                    ],
                                    "default": "default"
                                }
                            ]
                        },
                        {
                            "name": "setting",
                            "label": "Settings",
                            "widget": "object",
                            "fields": [
                                {
                                    "name": "heroEnabled",
                                    "label": "Show Hero",
                                    "widget": "boolean",
                                    "default": true
                                },
                                {
                                    "name": "categoriesEnabled",
                                    "label": "Show Categories",
                                    "widget": "boolean",
                                    "default": true
                                },
                                {
                                    "name": "productsEnabled",
                                    "label": "Show Products",
                                    "widget": "boolean",
                                    "default": true
                                },
                                {
                                    "name": "featuresEnabled",
                                    "label": "Show Features",
                                    "widget": "boolean",
                                    "default": true
                                },
                                {
                                    "name": "testimonialsEnabled",
                                    "label": "Show Testimonials",
                                    "widget": "boolean",
                                    "default": true
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}